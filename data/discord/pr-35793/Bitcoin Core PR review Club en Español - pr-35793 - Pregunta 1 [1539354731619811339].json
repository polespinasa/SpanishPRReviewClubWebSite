    {
      "id": "1541824788819873873",
      "type": "Default",
      "timestamp": "2026-08-25T17:01:15.374+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Por  que las legacy son mas costosas, entonces queremos limitar exclsuivamente el uso de ellas sin modifcar el uso de otras coo segwiit",
      "author": {
        "id": "342759576338300928",
        "name": "siegfried27",
        "discriminator": "0000",
        "nickname": "arejula27",
        "color": "#992D22",
        "isBot": false,
        "roles": [
          {
            "id": "1483542958153138197",
            "name": "PR Proposer",
            "color": "#992D22",
            "position": 1
          }
        ],
        "avatarUrl": "https://cdn.discordapp.com/avatars/342759576338300928/607f31f990f04c85f4b0500aa08cff4d.png?size=512"
      },
      "attachments": [],
      "embeds": [],
      "stickers": [],
      "reactions": [],
