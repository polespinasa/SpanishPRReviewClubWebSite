      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Imagina la wallet de Alice:\n\nTransacción padre `P`: Carol le paga a Bob.\nTransacción hija `C`: Bob gasta ese output para pagarle a Alice.",
      "author": {
        "id": "414546370742059020",
        "name": "leos021",
        "discriminator": "0000",
        "nickname": "Leo (w0xlt)",
        "color": null,
