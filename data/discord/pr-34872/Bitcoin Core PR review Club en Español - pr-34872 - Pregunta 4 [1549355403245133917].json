    },
    {
      "id": "1551996763760500958",
      "type": "Default",
      "timestamp": "2026-09-22T18:41:03.186+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "La wallet de Alice guarda `C` porque le paga a ella. No tiene ningún motivo para guardar `P`, ya que esa transacción solo involucraba a Carol y Bob.",
      "author": {
        "id": "414546370742059020",
        "name": "leos021",
        "discriminator": "0000",
        "nickname": "Leo (w0xlt)",
        "color": null,
