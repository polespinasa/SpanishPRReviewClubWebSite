    {
      "id": "1551992648707997848",
      "type": "Default",
      "timestamp": "2026-09-22T18:24:42.081+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "La función solo establece `fee` para `ALL`. En ese caso, la wallet aporta todos los inputs, por lo que puede calcular:\n\n`fee = wallet_debit − total_output_value`",
      "author": {
        "id": "414546370742059020",
        "name": "leos021",
        "discriminator": "0000",
        "nickname": "Leo (w0xlt)",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "https://cdn.discordapp.com/embed/avatars/4.png"
