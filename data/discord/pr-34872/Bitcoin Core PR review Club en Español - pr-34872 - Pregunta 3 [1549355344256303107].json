    {
      "id": "1551992608010801173",
      "type": "Default",
      "timestamp": "2026-09-22T18:24:32.378+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "`CachedTxGetHistoryAccounting()` devuelve una estructura `WalletTxHistoryAccounting` que contiene: `input_ownership`, `debit`, `credit` y `fee`.",
      "author": {
        "id": "414546370742059020",
        "name": "leos021",
        "discriminator": "0000",
        "nickname": "Leo (w0xlt)",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "https://cdn.discordapp.com/embed/avatars/4.png"
      },
      "attachments": [],
      "embeds": [],
      "stickers": [],
      "reactions": [
        {
          "emoji": {
            "id": "",
            "name": "\uD83D\uDC4D",
            "code": "thumbsup",
            "isAnimated": false,
            "imageUrl": "https://cdn.jsdelivr.net/gh/twitter/twemoji@latest/assets/svg/1f44d.svg"
          },
          "count": 1,
          "users": [
            {
              "id": "342759576338300928",
              "name": "siegfried27",
              "discriminator": "0000",
              "nickname": "arejula27",
              "color": "#992D22",
              "isBot": false,
              "avatarUrl": "https://cdn.discordapp.com/avatars/342759576338300928/607f31f990f04c85f4b0500aa08cff4d.png?size=512"
