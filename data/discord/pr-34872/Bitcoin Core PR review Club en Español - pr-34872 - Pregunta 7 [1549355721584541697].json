    },
    {
      "id": "1551999822540574812",
      "type": "Default",
      "timestamp": "2026-09-22T18:53:12.456+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Si un input ajeno a la wallet aporta fondos, conocer la comisión total de la transacción no permite determinar qué parte pagó tu wallet. Por eso, el RPC omite la parte de la comisión atribuible a la wallet en lugar de estimarla.",
