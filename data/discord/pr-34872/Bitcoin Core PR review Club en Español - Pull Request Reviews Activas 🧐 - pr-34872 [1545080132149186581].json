        "id": "433663137951252480",
        "name": "kepler_03j09",
        "discriminator": "0000",
        "nickname": "Kepler",
        "color": "#992D22",
        "isBot": false,
        "roles": [
          {
            "id": "1483542958153138197",
            "name": "PR Proposer",
            "color": "#992D22",
            "position": 1
