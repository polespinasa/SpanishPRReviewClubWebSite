      "timestamp": "2026-09-22T19:03:56.531+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Lo que cambia es la contabilización: si se sabe que todos los inputs ajenos a la wallet tienen valor cero, entonces nuestra wallet aportó todos los fondos, por lo que podemos informar de la comisión completa.",
      "author": {
        "id": "414546370742059020",
        "name": "leos021",
        "discriminator": "0000",
        "nickname": "Leo (w0xlt)",
        "color": null,
