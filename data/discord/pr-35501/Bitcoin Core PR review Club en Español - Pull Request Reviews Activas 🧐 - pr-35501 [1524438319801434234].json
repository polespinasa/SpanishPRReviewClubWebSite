    {
      "id": "1529551469643173990",
      "type": "Default",
      "timestamp": "2026-07-22T20:11:28.055+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "**Pregunta 2** -> ¿Por qué el wallet necesita almacenar todas las variantes de witness de una transacción? ¿Qué escenario práctico lo motiva?",
      "author": {
        "id": "174230257845403648",
        "name": ".sliv3r",
        "discriminator": "0000",
        "nickname": "Pol Espinasa",
        "color": "#E67E22",
        "isBot": false,
        "roles": [
          {
            "id": "1483542665147453490",
            "name": "Administrador",
            "color": "#E67E22",
            "position": 2
          }
        ],
        "avatarUrl": "https://cdn.discordapp.com/avatars/174230257845403648/e885d218ab790b012ea4fdd4ec5309fc.png?size=512"
