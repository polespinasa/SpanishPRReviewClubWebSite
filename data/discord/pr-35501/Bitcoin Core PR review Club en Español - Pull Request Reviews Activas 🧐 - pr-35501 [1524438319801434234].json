    {
      "id": "1529551376517173469",
      "type": "Default",
      "timestamp": "2026-07-22T20:11:05.852+02:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "**Pregunta 1** -> ¿Qué significa que dos transacciones compartan el mismo txid pero tengan diferentes wtxids? ¿Cómo es esto posible y qué implica sobre los inputs de la transacción?",
      "author": {
        "id": "174230257845403648",
        "name": ".sliv3r",
        "discriminator": "0000",
        "nickname": "Pol Espinasa",
        "color": "#E67E22",
        "isBot": false,
        "roles": [
